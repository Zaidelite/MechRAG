# Embedding & RAG Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=gemini-2.5-flash
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
